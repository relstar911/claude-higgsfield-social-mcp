# Copy this file to .env and fill in real values:
#   cp .env.example .env
#   set -a && source .env && set +a
#
# .env is gitignored -- NEVER commit real secrets. This file holds placeholders
# only. Every variable the code reads is listed here.

# ===========================================================================
# Higgsfield (media generation) -- REQUIRED to generate anything
# Set EITHER HF_KEY, OR both HF_API_KEY and HF_API_SECRET.
# ===========================================================================
HF_KEY=
# HF_API_KEY=
# HF_API_SECRET=

# Application endpoints on platform.higgsfield.ai (account-specific). Defaults
# shown; override to your real image/video application paths.
HF_IMAGE_MODEL=seedream
HF_VIDEO_MODEL=higgsfield-ai/standard

# ===========================================================================
# Anthropic (orchestration) -- only needed by agent_runner.py
# ===========================================================================
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# ===========================================================================
# Publishing provider: "zernio" (default, recommended) or "native"
# ===========================================================================
PUBLISH_PROVIDER=zernio

# --- Zernio (default provider) ---------------------------------------------
# Bearer key from your Zernio account (starts with sk_). Global profile id is a
# fallback; prefer per-persona zernio_profile_id in each PersonaConfig.
ZERNIO_API_KEY=
ZERNIO_PROFILE_ID=
# ZERNIO_BASE_URL=https://zernio.com/api   # optional override

# --- Native provider (fallback; only if PUBLISH_PROVIDER=native) -----------
# Instagram (Graph API) -- Business/Creator account + instagram_content_publish
# IG_USER_ID=
# IG_ACCESS_TOKEN=
# IG_GRAPH_VERSION=v21.0
# TikTok (Content Posting API) -- SELF_ONLY until your audit passes
# TIKTOK_ACCESS_TOKEN=
# TIKTOK_PRIVACY_LEVEL=SELF_ONLY
# X / Twitter (OAuth 1.0a user context)
# X_API_KEY=
# X_API_SECRET=
# X_ACCESS_TOKEN=
# X_ACCESS_TOKEN_SECRET=

# ===========================================================================
# Runtime / ops (all optional)
# ===========================================================================
# Local state file path (default: hf_social_state.json)
# HF_SOCIAL_STATE=hf_social_state.json
# Server transport: stdio | streamable-http | sse (default: stdio)
# HF_SOCIAL_TRANSPORT=stdio
# URL the agent runner uses to reach the MCP server (when served over HTTP)
# HF_SOCIAL_MCP_URL=https://your-host/mcp
